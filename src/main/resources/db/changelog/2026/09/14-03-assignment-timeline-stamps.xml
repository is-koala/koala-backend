<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-09-14-03-job-assignment-confirmed-at" author="koala">
        <addColumn tableName="job_assignments">
            <column name="confirmed_at" type="TIMESTAMPTZ"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="job_assignments" columnName="confirmed_at"/>
        </rollback>
    </changeSet>

    <changeSet id="2026-09-14-03-job-cancelled-at" author="koala">
        <addColumn tableName="jobs">
            <column name="cancelled_at" type="TIMESTAMPTZ"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="jobs" columnName="cancelled_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
