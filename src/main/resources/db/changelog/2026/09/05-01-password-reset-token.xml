<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="05-01-create-password-reset-tokens" author="koala">
        <createTable tableName="password_reset_tokens">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="token_digest" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_password_reset_tokens_digest"/>
            </column>
            <column name="expires_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="consumed_at" type="TIMESTAMPTZ"/>
            <column name="revoked_at" type="TIMESTAMPTZ"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
            <column name="created_by_id" type="UUID"/>
            <column name="updated_by_id" type="UUID"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by_id" type="UUID"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="password_reset_tokens" baseColumnNames="user_id"
                                 constraintName="fk_password_reset_tokens_user"
                                 referencedTableName="users" referencedColumnNames="id"/>

        <sql>
            CREATE UNIQUE INDEX IF NOT EXISTS uk_password_reset_tokens_active_user
                ON public.password_reset_tokens (user_id)
                WHERE consumed_at IS NULL AND revoked_at IS NULL AND is_deleted = false;
        </sql>
    </changeSet>

</databaseChangeLog>
