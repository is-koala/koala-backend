<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-09-06-80-offline-timesheet-events" author="koala">
        <addColumn tableName="work_sessions">
            <column name="check_in_client_event_id" type="UUID"/>
            <column name="check_in_captured_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="check_in_received_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="check_in_plausibility_flags" type="VARCHAR(255)"/>
            <column name="check_out_client_event_id" type="UUID"/>
            <column name="check_out_captured_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="check_out_received_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="check_out_plausibility_flags" type="VARCHAR(255)"/>
        </addColumn>
        <sql>
            CREATE UNIQUE INDEX uk_work_session_check_in_event
                ON work_sessions (job_assignment_id, check_in_client_event_id)
                WHERE check_in_client_event_id IS NOT NULL;
        </sql>
        <sql>
            CREATE UNIQUE INDEX uk_work_session_check_out_event
                ON work_sessions (job_assignment_id, check_out_client_event_id)
                WHERE check_out_client_event_id IS NOT NULL;
        </sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS uk_work_session_check_out_event;</sql>
            <sql>DROP INDEX IF EXISTS uk_work_session_check_in_event;</sql>
            <dropColumn tableName="work_sessions" columnName="check_out_plausibility_flags"/>
            <dropColumn tableName="work_sessions" columnName="check_out_received_at"/>
            <dropColumn tableName="work_sessions" columnName="check_out_captured_at"/>
            <dropColumn tableName="work_sessions" columnName="check_out_client_event_id"/>
            <dropColumn tableName="work_sessions" columnName="check_in_plausibility_flags"/>
            <dropColumn tableName="work_sessions" columnName="check_in_received_at"/>
            <dropColumn tableName="work_sessions" columnName="check_in_captured_at"/>
            <dropColumn tableName="work_sessions" columnName="check_in_client_event_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
