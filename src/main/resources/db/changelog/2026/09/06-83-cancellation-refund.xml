<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-09-06-83-cancellation-refund-column" author="koala">
        <addColumn tableName="cancellations">
            <column name="refund_id" type="UUID"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="cancellations" baseColumnNames="refund_id"
                                 constraintName="fk_cancellations_refund"
                                 referencedTableName="refunds" referencedColumnNames="id"
                                 validate="false"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="cancellations"
                                      constraintName="fk_cancellations_refund"/>
            <dropColumn tableName="cancellations" columnName="refund_id"/>
        </rollback>
    </changeSet>

    <changeSet id="2026-09-06-83-cancellation-refund-fk-validation" author="koala">
        <sql>ALTER TABLE cancellations VALIDATE CONSTRAINT fk_cancellations_refund</sql>
        <rollback/>
    </changeSet>

    <changeSet id="2026-09-06-83-cancellation-refund-unique" author="koala" runInTransaction="false">
        <sql>CREATE UNIQUE INDEX CONCURRENTLY uk_cancellations_refund
            ON cancellations (refund_id) WHERE refund_id IS NOT NULL</sql>
        <rollback>
            <sql>DROP INDEX CONCURRENTLY IF EXISTS uk_cancellations_refund</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
