<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-04-02-01-identity-document-file-url-index" author="koala">
        <sql>
            CREATE INDEX idx_media_verification_document_file_url ON media (file_url)
                WHERE media_type = 'VERIFICATION_DOCUMENT';
        </sql>
        <rollback>
            <sql>DROP INDEX IF EXISTS idx_media_verification_document_file_url;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
