<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="30-01-add-in-app-notification-columns" author="koala">
        <addColumn tableName="notifications">
            <column name="body" type="VARCHAR(1000)"/>
            <column name="target_type" type="VARCHAR(32)"/>
            <column name="target_id" type="UUID"/>
        </addColumn>

        <sql>
            CREATE INDEX IF NOT EXISTS ix_notifications_feed
                ON public.notifications (recipient_id, channel, created_at DESC);
        </sql>
    </changeSet>

</databaseChangeLog>
