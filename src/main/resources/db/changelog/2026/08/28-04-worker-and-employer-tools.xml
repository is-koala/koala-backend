<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-28-05-experiences" author="koala">
        <createTable tableName="experiences">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="UUID"><constraints nullable="false"/></column>
            <column name="title" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="company_name" type="VARCHAR(255)"/>
            <column name="employment_type" type="VARCHAR(24)"/>
            <column name="city_name" type="VARCHAR(255)"/>
            <column name="start_date" type="DATE"><constraints nullable="false"/></column>
            <column name="end_date" type="DATE"/>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
            <column name="created_by_id" type="UUID"/>
            <column name="updated_by_id" type="UUID"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="experiences" baseColumnNames="user_id"
                                 constraintName="fk_experiences_user"
                                 referencedTableName="users" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="2026-08-28-06-migrate-free-text-experiences" author="koala">
        <sql>
            INSERT INTO experiences (id, user_id, title, start_date, description, is_deleted, created_at)
            SELECT gen_random_uuid(), u.id, 'Aktarılan deneyim', CURRENT_DATE, u.experiences, false, now()
            FROM users u
            WHERE u.experiences IS NOT NULL AND btrim(u.experiences) &lt;&gt; '';
        </sql>
        <dropColumn tableName="users" columnName="experiences"/>
    </changeSet>

    <changeSet id="2026-08-28-07-availability" author="koala">
        <createTable tableName="availability_slots">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="UUID"><constraints nullable="false"/></column>
            <column name="day_of_week" type="VARCHAR(16)"><constraints nullable="false"/></column>
            <column name="start_time" type="TIME"><constraints nullable="false"/></column>
            <column name="end_time" type="TIME"><constraints nullable="false"/></column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
            <column name="created_by_id" type="UUID"/>
            <column name="updated_by_id" type="UUID"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="availability_slots" baseColumnNames="user_id"
                                 constraintName="fk_availability_slots_user"
                                 referencedTableName="users" referencedColumnNames="id"/>

        <createTable tableName="availability_exceptions">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="UUID"><constraints nullable="false"/></column>
            <column name="exception_date" type="DATE"><constraints nullable="false"/></column>
            <column name="available" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="note" type="VARCHAR(255)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
            <column name="created_by_id" type="UUID"/>
            <column name="updated_by_id" type="UUID"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="availability_exceptions" baseColumnNames="user_id"
                                 constraintName="fk_availability_exceptions_user"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <sql>
            CREATE UNIQUE INDEX uk_availability_exceptions_user_date
                ON availability_exceptions (user_id, exception_date) WHERE is_deleted = false;
        </sql>
    </changeSet>

    <changeSet id="2026-08-28-08-talent-pool" author="koala">
        <createTable tableName="talent_pool_entries">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="employer_id" type="UUID"><constraints nullable="false"/></column>
            <column name="worker_id" type="UUID"><constraints nullable="false"/></column>
            <column name="company_id" type="UUID"/>
            <column name="note" type="VARCHAR(1000)"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
            <column name="created_by_id" type="UUID"/>
            <column name="updated_by_id" type="UUID"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="talent_pool_entries" baseColumnNames="employer_id"
                                 constraintName="fk_talent_pool_employer"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="talent_pool_entries" baseColumnNames="worker_id"
                                 constraintName="fk_talent_pool_worker"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="talent_pool_entries" baseColumnNames="company_id"
                                 constraintName="fk_talent_pool_company"
                                 referencedTableName="companies" referencedColumnNames="id"/>
        <sql>
            CREATE UNIQUE INDEX uk_talent_pool_employer_worker
                ON talent_pool_entries (employer_id, worker_id) WHERE is_deleted = false;
        </sql>
    </changeSet>

    <changeSet id="2026-08-28-09-job-templates" author="koala">
        <createTable tableName="job_templates">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="owner_id" type="UUID"><constraints nullable="false"/></column>
            <column name="company_id" type="UUID"/>
            <column name="template_name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="job_category_id" type="UUID"/>
            <column name="title" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(4000)"/>
            <column name="sector" type="VARCHAR(255)"/>
            <column name="position" type="VARCHAR(255)"/>
            <column name="duties" type="VARCHAR(2000)"/>
            <column name="dress_code" type="VARCHAR(255)"/>
            <column name="job_type" type="VARCHAR(32)"/>
            <column name="salary_type" type="VARCHAR(32)"/>
            <column name="salary" type="NUMERIC(19,2)"/>
            <column name="min_age" type="INTEGER"/>
            <column name="max_age" type="INTEGER"/>
            <column name="experience_required" type="BOOLEAN"/>
            <column name="insurance_required" type="BOOLEAN"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
            <column name="created_by_id" type="UUID"/>
            <column name="updated_by_id" type="UUID"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="job_templates" baseColumnNames="owner_id"
                                 constraintName="fk_job_templates_owner"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="job_templates" baseColumnNames="company_id"
                                 constraintName="fk_job_templates_company"
                                 referencedTableName="companies" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="job_templates" baseColumnNames="job_category_id"
                                 constraintName="fk_job_templates_category"
                                 referencedTableName="job_categories" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="2026-08-28-10-job-alerts" author="koala">
        <createTable tableName="job_alerts">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="UUID"><constraints nullable="false"/></column>
            <column name="alert_name" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="job_category_id" type="UUID"/>
            <column name="city_name" type="VARCHAR(255)"/>
            <column name="district_name" type="VARCHAR(255)"/>
            <column name="min_salary" type="NUMERIC(19,2)"/>
            <column name="job_type" type="VARCHAR(32)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"><constraints nullable="false"/></column>
            <column name="last_notified_at" type="TIMESTAMPTZ"/>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
            <column name="created_by_id" type="UUID"/>
            <column name="updated_by_id" type="UUID"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="job_alerts" baseColumnNames="user_id"
                                 constraintName="fk_job_alerts_user"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="job_alerts" baseColumnNames="job_category_id"
                                 constraintName="fk_job_alerts_category"
                                 referencedTableName="job_categories" referencedColumnNames="id"/>
        <createIndex tableName="job_alerts" indexName="idx_job_alerts_active">
            <column name="is_active"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
