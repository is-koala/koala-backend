<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-27-30-company-contacts-audit-columns" author="koala">
        <addColumn tableName="company_contacts">
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
            <column name="created_by_id" type="UUID"/>
            <column name="updated_by_id" type="UUID"/>
        </addColumn>
        <sql>
            CREATE UNIQUE INDEX uk_company_contacts_membership_active
                ON company_contacts (company_id, user_id) WHERE is_deleted = false;
        </sql>
        <rollback>
            <dropIndex tableName="company_contacts" indexName="uk_company_contacts_membership_active"/>
            <dropColumn tableName="company_contacts" columnName="updated_by_id"/>
            <dropColumn tableName="company_contacts" columnName="created_by_id"/>
            <dropColumn tableName="company_contacts" columnName="updated_at"/>
            <dropColumn tableName="company_contacts" columnName="created_at"/>
            <dropColumn tableName="company_contacts" columnName="deleted_by_id"/>
            <dropColumn tableName="company_contacts" columnName="deleted_at"/>
            <dropColumn tableName="company_contacts" columnName="is_deleted"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
