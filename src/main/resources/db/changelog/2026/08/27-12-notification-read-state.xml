<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-27-29-notification-read-at" author="koala">
        <addColumn tableName="notifications">
            <column name="read_at" type="TIMESTAMPTZ"/>
        </addColumn>
        <createIndex tableName="notifications" indexName="idx_notifications_recipient_unread">
            <column name="recipient_id"/>
            <column name="read_at"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="notifications" indexName="idx_notifications_recipient_unread"/>
            <dropColumn tableName="notifications" columnName="read_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
