<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-28-09-company-follows" author="koala">
        <createTable tableName="company_follows">
            <column name="id" type="UUID"><constraints primaryKey="true" nullable="false"/></column>
            <column name="follower_id" type="UUID"><constraints nullable="false"/></column>
            <column name="company_id" type="UUID"><constraints nullable="false"/></column>
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="deleted_at" type="TIMESTAMPTZ"/>
            <column name="deleted_by_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMPTZ"/>
            <column name="created_by_id" type="UUID"/>
            <column name="updated_by_id" type="UUID"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="company_follows" baseColumnNames="follower_id"
                                 constraintName="fk_company_follows_follower"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="company_follows" baseColumnNames="company_id"
                                 constraintName="fk_company_follows_company"
                                 referencedTableName="companies" referencedColumnNames="id"/>
        <sql>
            CREATE UNIQUE INDEX uk_company_follows_active
                ON company_follows (company_id, follower_id) WHERE is_deleted = false
        </sql>
        <sql>
            CREATE INDEX ix_company_follows_follower ON company_follows (follower_id)
        </sql>
    </changeSet>

</databaseChangeLog>
