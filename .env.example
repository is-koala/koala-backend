# ---- server ----
SERVER_PORT=8080
# gzip: swagger-ui-bundle.js ~1.4 MB, sikistirmasiz yuklenmesi saniyeler suruyor
SERVER_COMPRESSION_ENABLED=true
SERVICE_NAME=koala
# Empty uses the Maven project version baked into the image (pom.xml / v* tag).
# A stale Dokploy value such as 0.0.1 overrides that and is what the UI shows.
SERVICE_VERSION=
# local | staging | production. Baska bir deger uygulamayi acilista dusurur.
# Iyzico sandbox/canli ayrimi da bu degere bagli: local sandbox ve loopback,
# staging yalnizca sandbox, production yalnizca canli baseUrl kabul eder.
# Uygulama yapilandirma kapisi (app.deployment) da bu degeri okur; yalnizca
# production'da CORS, guvenilir proxy, springdoc ve surum sapmasini bildirir.
SERVICE_ENVIRONMENT=local

# ---- local docker compose resource limits ----
# Yalnizca repodaki docker-compose.yml ile acilan yerel servisleri sinirlar.
# Production uc ayri Dokploy servisi kullanir; limitler Dokploy'da ayrica verilmelidir.
KOALA_APP_MEM=1200m
KOALA_DB_MEM=768m
KOALA_RABBITMQ_MEM=384m
RABBITMQ_MEM_WATERMARK=0.6

# ---- database ----
# POSTGRES_* yalnizca docker-compose'un ayaga kaldirdigi yerel Postgres icindir.
# Dokploy'da veritabani ayri bir servis oldugu icin uygulamaya yalnizca DB_* gerekir.
POSTGRES_DB=koaladb
POSTGRES_USER=koala
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://koala-db:5432/koaladb
DB_USERNAME=koala
DB_PASSWORD=change-me
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ---- urls ----
API_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
PAYMENTS_RETURN_BASE_URL=koala-staging://
AUTH_LINK_PUBLIC_BASE_URL=http://localhost:3000
AUTH_LINK_APP_SCHEME=koala-staging
CORS_ALLOWED_ORIGINS=
STOMP_PRODUCTION_ORIGIN=https://iskoala.com
STOMP_STAGING_ORIGIN=https://staging.iskoala.com
STOMP_DEVELOPMENT_ORIGIN=http://localhost:3000

# ---- auth ----
# openssl rand -base64 48
JWT_SECRET=generate-a-long-random-base64-secret
JWT_ACCESS_TOKEN_EXPIRATION_MS=43200000
JWT_PASSWORD_SET_EXPIRATION_MS=600000
PASSWORD_RESET_TOKEN_VALIDITY_MS=900000
SESSION_REFRESH_VALIDITY_DAYS=30
SESSION_REFRESH_SLIDING_WINDOW_DAYS=7

# Taze bir veritabaninda ilk yoneticiyi yaratan tek adim. Bu e-postayla kayitli
# kullaniciya acilista ROLE_ADMIN yazilir; idempotenttir, ikinci acilista hicbir sey
# yapmaz ve kullanici yoksa uygulama dusmez, yalnizca uyari loglanir. Rolu veren
# kimse olmadigi icin granted_by_id bos kalir. Ilk yonetici olustuktan sonra
# degisken kaldirilmalidir; sonraki roller POST /admin/users/{userId}/roles ile verilir.
ADMIN_BOOTSTRAP_EMAIL=

# ---- mail ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DELIVERY_MODE=ALLOWLIST
MAIL_ALLOWED_RECIPIENTS=
# Tanıtım sitesi iletişim formu alıcısı. SMTP kullanıcısı olmak zorunda
# değil. ALLOWLIST iken bu adres MAIL_ALLOWED_RECIPIENTS içinde olmalı.
SUPPORT_MAILBOX=info@iskoala.com

# ---- rabbitmq ----
RABBITMQ_HOST=koala-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# ---- sms ----
SMS_API_KEY=
SMS_API_HASH=
SMS_SENDER=KOALA

# ---- Firebase push ----
# Disabled until dev/staging=iskoala-staging and production=iskoala credentials are mounted and accepted on devices.
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CONNECT_TIMEOUT=5s
FIREBASE_READ_TIMEOUT=10s
FIREBASE_WRITE_TIMEOUT=10s
PUSH_MAX_ATTEMPTS=3
PUSH_INITIAL_BACKOFF=1m
PUSH_MAX_BACKOFF=15m
PUSH_MAX_PROVIDER_DEFERRAL=24h
PUSH_CLAIM_TIMEOUT=10m
PUSH_BATCH_SIZE=100
PUSH_DELIVERY_FIXED_DELAY=30s

# ---- IYS commercial-message registry ----
# Keep disabled until the brand, ETBIS/legal prerequisites and controlled provider validation are complete.
IYS_ENABLED=false
IYS_API_URL=https://api.iletimerkezi.com/v1/consent
IYS_API_KEY=
IYS_API_HASH=
IYS_BRAND_CODE=
# Must be the provider-approved source that actually describes this preference centre (for example HS_WEB).
IYS_SOURCE_WEB=HS_WEB
IYS_SOURCE_MOBILE=HS_MOBIL
IYS_SOURCE_UNKNOWN=HS_EORTAM
IYS_SOURCE_UNSUBSCRIBE=HS_EPOSTA
IYS_PERMISSION_MAX_AGE=1h
IYS_CLAIM_TIMEOUT=5m
IYS_RECIPIENT_ENCRYPTION_KEY=
IYS_DELETION_WITHDRAWAL_RETENTION=3d
IYS_RETRY_ENABLED=true
IYS_RETRY_FIXED_DELAY=30s
IYS_RETRY_MAX_ATTEMPTS=8
IYS_RETRY_INITIAL_BACKOFF=1m
IYS_RETRY_MAX_BACKOFF=6h
IYS_RETRY_BATCH_SIZE=50
IYS_RECONCILIATION_ENABLED=true
IYS_RECONCILIATION_FIXED_DELAY=15m
IYS_RECONCILIATION_BATCH_SIZE=50

# ---- payment ----
# Canli anahtarlar yalnizca SERVICE_ENVIRONMENT=production olan ortamda durur.
# Canli baseUrl: https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_SETTLEMENT_ENABLED=true
# Checkout Form initialize her zaman forceThreeDS=1 gonderir; mdStatus kapisi
# (CLAUDE.md 2x2) ancak boyle her odemede karar verebilir. false yalniz sandbox
# denemesi icindir; alan hic gonderilmez ve 3DS'siz SUCCESS VERIFY_PENDING'de kalir.
IYZICO_FORCE_3DS=true
IYZICO_SETTLEMENT_RETRY_ENABLED=true
IYZICO_SETTLEMENT_MAX_ATTEMPTS=8
IYZICO_SETTLEMENT_INITIAL_BACKOFF=1m
IYZICO_SETTLEMENT_MAX_BACKOFF=6h
IYZICO_SETTLEMENT_BATCH_SIZE=50
IYZICO_SETTLEMENT_CRON=0 */5 * * * *
# Iyzico alt üye işyeri profil senkronu. Rabbit yalnız tetikleyicidir; intent
# user_profile_sync_outbox satırında kalıcıdır. Broker kapalıyken profil
# güncellemesi kaybolmaz.
USER_PROFILE_SYNC_DISPATCH_ENABLED=true
USER_PROFILE_SYNC_DISPATCH_FIXED_DELAY=PT5S
USER_PROFILE_SYNC_DISPATCH_MAX_ATTEMPTS=8
USER_PROFILE_SYNC_DISPATCH_INITIAL_BACKOFF=PT5S
USER_PROFILE_SYNC_DISPATCH_MAX_BACKOFF=PT5M
USER_PROFILE_SYNC_DISPATCH_JITTER_FACTOR=0.5
USER_PROFILE_SYNC_DISPATCH_CLAIM_TIMEOUT=PT5M
USER_PROFILE_SYNC_DISPATCH_PUBLISHER_CONFIRM_TIMEOUT=PT10S
USER_PROFILE_SYNC_PROCESSING_CLAIM_TIMEOUT=PT5M
USER_PROFILE_SYNC_DISPATCH_BATCH_SIZE=50
# COMMISSION_RATE yalnizca baslangic degeridir: app_settings icinde commission.rate satiri
# yoksa bu deger kullanilir. Canli oran PUT /admin/settings/commission.rate ile degistirilir
# ve deploy gerektirmez.
COMMISSION_RATE=0.075

# ---- storage ----
# STORAGE_TYPE=local diske yazar, s3 icin bucket ve anahtarlar zorunlu.
# STORAGE_ENDPOINT yalnizca S3 uyumlu baska bir servis (R2, MinIO) kullanilirsa doldurulur.
# STORAGE_PUBLIC_URL bos birakilirsa images/ de API uzerinden servis edilir, CDN devreye girmez.
STORAGE_TYPE=local
STORAGE_BUCKET=
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=
# Ozgecmis ve kimlik belgesi icin kisa tut; imzali adres o sure boyunca kimlik dogrulamasi istemez
STORAGE_SIGNED_URL_MINUTES=3
STORAGE_LOCAL_PATH=uploads

# ---- upload limits ----
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=42MB
MAX_SWALLOW_SIZE=50MB
UPLOAD_MAX_IMAGE_SIZE_MB=10
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_COMPANY_IMAGES=10
UPLOAD_MAX_JOB_IMAGES=10
# Sikistirma bombasi savunmasi: 10 MB'lik bir PNG milyarlarca piksele acilabilir
UPLOAD_MAX_IMAGE_MEGAPIXELS=50

# ---- policy ----
CANCELLATION_FREE_WINDOW_HOURS=24
CANCELLATION_LATE_FEE_RATE=0.50
CANCELLATION_ZONE_ID=Europe/Istanbul
ASSIGNMENT_AUTO_COMPLETION_ENABLED=true
ASSIGNMENT_AUTO_COMPLETION_GRACE_DAYS=3
ASSIGNMENT_AUTO_COMPLETION_ZONE_ID=Europe/Istanbul
ASSIGNMENT_AUTO_COMPLETION_BATCH_SIZE=100
ASSIGNMENT_AUTO_COMPLETION_CRON=0 15 * * * *

# Ödemesi alınmamış atama, iş başlangıcına bu kadar saat kala kendiliğinden düşer.
ASSIGNMENT_UNPAID_EXPIRY_ENABLED=true
ASSIGNMENT_UNPAID_EXPIRY_HOURS_BEFORE_START=6
ASSIGNMENT_UNPAID_EXPIRY_BATCH_SIZE=100
ASSIGNMENT_UNPAID_EXPIRY_ZONE_ID=Europe/Istanbul
ASSIGNMENT_UNPAID_EXPIRY_CRON=0 45 * * * *

# Servis hatırlatmaları: iş gününden önceki akşam (evening-at, zone-id dilimi) ve kalkıştan lead dakika önce.
TRANSPORT_REMINDERS_ENABLED=true
TRANSPORT_REMINDERS_ZONE_ID=Europe/Istanbul
TRANSPORT_REMINDERS_EVENING_AT=19:00
TRANSPORT_REMINDERS_DEPARTURE_LEAD_MINUTES=60
TRANSPORT_REMINDERS_BOARDING_LEAD_MINUTES=15
TRANSPORT_REMINDERS_NOT_BOARDED_AFTER_MINUTES=10
TRANSPORT_REMINDERS_NOT_BOARDED_LOOKBACK_MINUTES=60
TRANSPORT_REMINDERS_BATCH_SIZE=200
TRANSPORT_REMINDERS_CRON=0 */5 * * * *
ACCOUNT_DELETION_ENABLED=true
ACCOUNT_DELETION_WAITING_PERIOD=30d
ACCOUNT_DELETION_BATCH_SIZE=100
ACCOUNT_DELETION_CRON=0 30 2 * * *

# Hakedis banka mutabakati beklerken ne kadar sonra "vadesi gecti" sayilir. Zamanlayici
# bu esikten eski PROCESSING satirlari sayip koala_payout_settlement_overdue gostergesine
# yaziyor; KoalaPayoutSettlementOverdue alarmi onu izliyor. Esik docs/runbooks/payments.md
# 4. bolumdeki kuyruk sorgusuyla ayni olmali (CLAUDE.md 2y3).
PAYOUT_SETTLEMENT_OVERDUE_MONITORING_ENABLED=true
PAYOUT_SETTLEMENT_OVERDUE_AFTER=3d
# Ikinci kademe: ilk yukseltme de satiri kapatmadiysa. Bu esikten eski satirlar
# koala_payout_settlement_stalled gostergesine yaziliyor ve KoalaPayoutSettlementStalled
# alarmini atesliyor. PAYOUT_SETTLEMENT_OVERDUE_AFTER degerinden buyuk olmali, degilse
# uygulama acilista duser.
PAYOUT_SETTLEMENT_STALLED_AFTER=10d
PAYOUT_SETTLEMENT_OVERDUE_CRON=0 20 * * * *

# Admin denetim kaydinin saklama penceresi. Cekirdek satir 24 ay, finansal olan 10 yil,
# detay (istek govdesi, IP, user agent, once/sonra) 6 ay saklanir.
AUDIT_RETENTION_ENABLED=true
AUDIT_RETENTION_CORE_MONTHS=24
AUDIT_RETENTION_FINANCIAL_CORE_MONTHS=120
AUDIT_RETENTION_DETAIL_MONTHS=6
AUDIT_RETENTION_CRON=0 30 3 * * *

# Giris denemesi saklama penceresi. Hesaba bagli satir 365 gun, hicbir hesaba ait
# olmayan (sahipsiz) satir 30 gun saklanir.
# DIKKAT: bu dort deger dogrulaniyor ve yanlisi uygulamayi ACILISTA dusurur.
# Iki gun degeri de en az 1 olmali ve sahipsiz pencere bagli pencereden uzun olamaz.
LOGIN_ATTEMPT_RETENTION_ENABLED=true
LOGIN_ATTEMPT_RETENTION_ATTRIBUTED_DAYS=365
LOGIN_ATTEMPT_RETENTION_UNATTRIBUTED_DAYS=30
LOGIN_ATTEMPT_RETENTION_CRON=0 50 3 * * *

# GeoIP: MaxMind GeoLite2-City .mmdb dosyasinin konteyner icindeki yolu.
# Bos birakilirsa uygulama acilir, oturum/giris konumu null kalir (uyari loglanir).
# Indirme, atif ve haftalik guncelleme: docs/runbooks/geoip.md
GEOIP_DATABASE_PATH=

# ---- features ----
# Is bittikten sonra mesajlasmanin acik kalacagi gun sayisi; sonrasinda sohbet salt okunur
MESSAGING_GRACE_DAYS_AFTER_JOB=7
MESSAGING_ZONE_ID=Europe/Istanbul
JOB_SEARCH_ZONE_ID=Europe/Istanbul
# Sitemap manifesti bir snapshot'i 1 saat okunabilir tutar; son 15 dakikaya
# girildiginde yeni index istegi yeni version uretir, eski shard'lar TTL sonuna
# kadar calisir. Bir shard protokol geregi 50.000 URL'yi asamaz.
SITEMAP_MANIFEST_TTL=1h
SITEMAP_MANIFEST_REFRESH_BEFORE_EXPIRY=15m
SITEMAP_MANIFEST_SHARD_SIZE=50000
SITEMAP_MANIFEST_MAX_SHARDS=50000
SITEMAP_MANIFEST_QUERY_TIMEOUT=20s
SITEMAP_MANIFEST_LOCK_TIMEOUT=5s
JOB_ALERT_ENABLED=true
JOB_ALERT_MAX_PER_USER=10
COMPANY_FOLLOW_ENABLED=true
REALTIME_ENABLED=true
REALTIME_ENDPOINT=/ws
REALTIME_TYPING_TIMEOUT=5s
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_UPLOAD_MAX_ATTEMPTS=20
RATE_LIMIT_UPLOAD_WINDOW=1m
RATE_LIMIT_MESSAGE_MAX_ATTEMPTS=30
RATE_LIMIT_MESSAGE_WINDOW=1m
RATE_LIMIT_WRITE_MAX_ATTEMPTS=60
RATE_LIMIT_WRITE_WINDOW=1m
RATE_LIMIT_ADDRESS_SEARCH_MAX_ATTEMPTS=60
RATE_LIMIT_ADDRESS_SEARCH_WINDOW=1m
RATE_LIMIT_PUBLIC_MAX_ATTEMPTS=120
RATE_LIMIT_PUBLIC_WINDOW=1m
RATE_LIMIT_SITEMAP_MAX_ATTEMPTS=30
RATE_LIMIT_SITEMAP_WINDOW=1m
RATE_LIMIT_REALTIME_CREDENTIAL_MAX_ATTEMPTS=10
RATE_LIMIT_REALTIME_CREDENTIAL_WINDOW=1m
# Isveren basina isci kimligi (TCKN) okuma butcesi; anahtar isveren kullanici id'si, filtre degil manager (#312)
RATE_LIMIT_IDENTITY_REVEAL_MAX_ATTEMPTS=30
RATE_LIMIT_IDENTITY_REVEAL_WINDOW=1h
# Binis kovasi IP basina; ayni telefondan 100 koltukluk servis taranabilsin diye genel yazmanin iki kati (#298)
RATE_LIMIT_BOARDING_MAX_ATTEMPTS=120
RATE_LIMIT_BOARDING_WINDOW=1m
TRANSPORT_BOARDING_TOKEN_TTL=PT10M
TRANSPORT_BOARDING_FAR_FROM_STOP_METERS=250
TRANSPORT_BOARDING_SCHEDULE_TOLERANCE=PT30M

# ---- address assistance ----
# Mobil Maps SDK anahtarini burada kullanmayin. Bu anahtar yalniz backend'de
# kalmali; Places API (New) + Geocoding API ve mumkunse sabit cikis IP'siyle
# kisitlanmalidir. Billing, kota ve butce alarmlari acilmadan ozelligi acmayin.
ADDRESS_SEARCH_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com
ADDRESS_SEARCH_SESSION_TTL=5m
ADDRESS_CANDIDATE_TTL=10m

# ---- api docs ----
# Yerel gelistirmede acik; production'da verilmezse guvenli varsayilan false'tur.
# Acikken tum uc, DTO semasi ve zorunlu alanlar herkese gorunur.
SPRINGDOC_ENABLED=true

# ---- logging ----
APP_LOG_LEVEL=INFO
ACCESS_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO
# Yauaa acilista ~22 saniye INFO logluyor; teshis gerekmedikce WARN kalir.
USER_AGENT_LOG_LEVEL=WARN
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Asgari istemci surumu kapisi. Bos birakilirsa kimse engellenmez.
# Canlida degistirmek icin PUT /admin/settings/app.minimum-version kullanilir (deploy gerekmez).
APP_MINIMUM_VERSION=
APP_MINIMUM_VERSION_IOS=
APP_MINIMUM_VERSION_ANDROID=
APP_MINIMUM_VERSION_WEB=
APP_TRUSTED_PROXIES=

# Pasif kimlik dogrulama (ICAO 9303). Kapaliyken sunucu cipten gelen kaniti aramaz.
# Acmadan once IDENTITY_CSCA_DIRECTORY dolu olmali, aksi halde her dogrulama reddedilir.
IDENTITY_PASSIVE_AUTH_ENABLED=false
IDENTITY_CSCA_DIRECTORY=
IDENTITY_ACTIVE_AUTH_REQUIRED=false
IDENTITY_CHALLENGE_VALIDITY_MINUTES=10

# IBAN sahipligi dogrulama transferi. Kullanici kayitli IBAN'indan bu hesaba
# kucuk tutarli bir transfer yapar; gonderen IBAN kayitli IBAN'la karsilastirilir.
# BANK_VERIFICATION_COLLECTION_IBAN bos birakilirsa dogrulama baslatilamaz ve
# hicbir isci emanetten para alamaz - once Koala'nin tahsilat IBAN'ini girin.
BANK_VERIFICATION_COLLECTION_IBAN=
BANK_VERIFICATION_VALIDITY_HOURS=72
BANK_VERIFICATION_MAX_ATTEMPTS=5
BANK_VERIFICATION_MIN_AMOUNT=1.01
BANK_VERIFICATION_MAX_AMOUNT=1.99

# ---- personel kimligi ----
# ADR-0014: Keycloak kullanilmiyor; personel kimligi, parolasi ve rol uyeligi
# Koala'da. Token'i Koala uretiyor ve JWT_SECRET ile imzaliyor, yani ayri bir
# imza anahtari yok. Marketplace token'indan audience claim'i ile ayriliyor.
STAFF_ACCESS_TOKEN_VALIDITY=15m
STAFF_REFRESH_TOKEN_VALIDITY=12h
# Kaba kuvvet karsiligi: MFA yok (ADR-0014 §Sonuclar bunu acik gerileme olarak
# kaydetti), yerine hiz siniri (§2j AUTH kovasi) ve hesap kilidi var.
STAFF_MAX_FAILED_ATTEMPTS=5
STAFF_LOCK_DURATION=15m

# ADR-0010 §Gecis'in marketplace ROLE_ADMIN koprusu personel girisi indigi icin
# KAPALI. Yalnizca /admin/** kapisi geri acilabilir; aktorsuz para hareketi
# dali silindi, o geri acilamaz. Bir sorunda gecici olarak true yapilabilir.
STAFF_MARKETPLACE_BRIDGE_OPEN=false

# Taze bir veritabaninda ilk OWNER personelini yaratan tek adim: iki degisken
# birden verilir ve uygulama yeniden baslatilir. staff_members tablosu BOS
# degilse hicbir sey yazilmaz, log'a "bootstrap atlandi, N personel var" duser
# ve var olan bir hesabin parolasi asla ezilmez. Degiskenlerden biri eksikse
# bootstrap hic calismaz; eksiklik hata degildir.
# BOOTSTRAP_OWNER_PASSWORD bir sirdir (docs/secrets-inventory.md): hesap
# olustuktan ve ilk giriste parola degistirildikten sonra Dokploy'dan
# SILINMELIDIR. Hesap "ilk giriste parola degistir" bayragiyla dogar; o bayrak
# inene kadar /admin/** in geri kalani 403 doner.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
