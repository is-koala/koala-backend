# ---- server ----
SERVER_PORT=8080
# gzip: swagger-ui-bundle.js ~1.4 MB, sikistirmasiz yuklenmesi saniyeler suruyor
SERVER_COMPRESSION_ENABLED=true
SERVICE_NAME=koala
SERVICE_VERSION=
SERVICE_ENVIRONMENT=

# ---- database ----
# POSTGRES_* yalnizca docker-compose'un ayaga kaldirdigi yerel Postgres icindir.
# Dokploy'da veritabani ayri bir servis oldugu icin uygulamaya yalnizca DB_* gerekir.
POSTGRES_DB=koaladb
POSTGRES_USER=koala
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://koala-db:5432/koaladb
DB_USERNAME=koala
DB_PASSWORD=change-me
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ---- urls ----
API_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
PAYMENTS_RETURN_BASE_URL=koala-staging://
AUTH_LINK_PUBLIC_BASE_URL=http://localhost:3000
AUTH_LINK_APP_SCHEME=koala-staging
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- auth ----
# openssl rand -base64 48
JWT_SECRET=generate-a-long-random-base64-secret
JWT_ACCESS_TOKEN_EXPIRATION_MS=43200000
JWT_PASSWORD_SET_EXPIRATION_MS=600000
PASSWORD_RESET_TOKEN_VALIDITY_MS=900000
SESSION_REFRESH_VALIDITY_DAYS=30
SESSION_REFRESH_SLIDING_WINDOW_DAYS=7

# ---- mail ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DELIVERY_MODE=ALLOWLIST
MAIL_ALLOWED_RECIPIENTS=

# ---- rabbitmq ----
RABBITMQ_HOST=koala-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

# ---- sms ----
SMS_API_KEY=
SMS_API_HASH=
SMS_SENDER=KOALA

# ---- payment ----
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_SETTLEMENT_ENABLED=true
IYZICO_SETTLEMENT_RETRY_ENABLED=true
IYZICO_SETTLEMENT_MAX_ATTEMPTS=8
IYZICO_SETTLEMENT_INITIAL_BACKOFF=1m
IYZICO_SETTLEMENT_MAX_BACKOFF=6h
IYZICO_SETTLEMENT_BATCH_SIZE=50
IYZICO_SETTLEMENT_CRON=0 */5 * * * *
# COMMISSION_RATE yalnizca baslangic degeridir: app_settings icinde commission.rate satiri
# yoksa bu deger kullanilir. Canli oran PUT /admin/settings/commission.rate ile degistirilir
# ve deploy gerektirmez.
COMMISSION_RATE=0.075

# ---- storage ----
# STORAGE_TYPE=local diske yazar, s3 icin bucket ve anahtarlar zorunlu.
# STORAGE_ENDPOINT yalnizca S3 uyumlu baska bir servis (R2, MinIO) kullanilirsa doldurulur.
# STORAGE_PUBLIC_URL bos birakilirsa images/ de API uzerinden servis edilir, CDN devreye girmez.
STORAGE_TYPE=local
STORAGE_BUCKET=
STORAGE_REGION=eu-central-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=
# Ozgecmis ve kimlik belgesi icin kisa tut; imzali adres o sure boyunca kimlik dogrulamasi istemez
STORAGE_SIGNED_URL_MINUTES=3
STORAGE_LOCAL_PATH=uploads

# ---- upload limits ----
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
UPLOAD_MAX_IMAGE_SIZE_MB=10
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_COMPANY_IMAGES=10
UPLOAD_MAX_JOB_IMAGES=10
# Sikistirma bombasi savunmasi: 10 MB'lik bir PNG milyarlarca piksele acilabilir
UPLOAD_MAX_IMAGE_MEGAPIXELS=50

# ---- policy ----
CANCELLATION_FREE_WINDOW_HOURS=24
CANCELLATION_LATE_FEE_RATE=0.50
CANCELLATION_ZONE_ID=Europe/Istanbul
ASSIGNMENT_AUTO_COMPLETION_ENABLED=true
ASSIGNMENT_AUTO_COMPLETION_GRACE_DAYS=3
ASSIGNMENT_AUTO_COMPLETION_ZONE_ID=Europe/Istanbul
ASSIGNMENT_AUTO_COMPLETION_BATCH_SIZE=100
ASSIGNMENT_AUTO_COMPLETION_CRON=0 15 * * * *

# Ödemesi alınmamış atama, iş başlangıcına bu kadar saat kala kendiliğinden düşer.
ASSIGNMENT_UNPAID_EXPIRY_ENABLED=true
ASSIGNMENT_UNPAID_EXPIRY_HOURS_BEFORE_START=6
ASSIGNMENT_UNPAID_EXPIRY_BATCH_SIZE=100
ASSIGNMENT_UNPAID_EXPIRY_ZONE_ID=Europe/Istanbul
ASSIGNMENT_UNPAID_EXPIRY_CRON=0 45 * * * *

# ---- features ----
# Is bittikten sonra mesajlasmanin acik kalacagi gun sayisi; sonrasinda sohbet salt okunur
MESSAGING_GRACE_DAYS_AFTER_JOB=7
MESSAGING_ZONE_ID=Europe/Istanbul
JOB_SEARCH_ZONE_ID=Europe/Istanbul
JOB_ALERT_ENABLED=true
JOB_ALERT_MAX_PER_USER=10
COMPANY_FOLLOW_ENABLED=true
REALTIME_ENABLED=true
REALTIME_ENDPOINT=/ws
REALTIME_TYPING_TIMEOUT=5s
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_UPLOAD_MAX_ATTEMPTS=20
RATE_LIMIT_UPLOAD_WINDOW=1m
RATE_LIMIT_MESSAGE_MAX_ATTEMPTS=30
RATE_LIMIT_MESSAGE_WINDOW=1m
RATE_LIMIT_WRITE_MAX_ATTEMPTS=60
RATE_LIMIT_WRITE_WINDOW=1m
RATE_LIMIT_ADDRESS_SEARCH_MAX_ATTEMPTS=60
RATE_LIMIT_ADDRESS_SEARCH_WINDOW=1m

# ---- address assistance ----
# Mobil Maps SDK anahtarini burada kullanmayin. Bu anahtar yalniz backend'de
# kalmali; Places API (New) + Geocoding API ve mumkunse sabit cikis IP'siyle
# kisitlanmalidir. Billing, kota ve butce alarmlari acilmadan ozelligi acmayin.
ADDRESS_SEARCH_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com
GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com
ADDRESS_SEARCH_SESSION_TTL=5m
ADDRESS_CANDIDATE_TTL=10m

# ---- api docs ----
# Yerel gelistirmede acik; production'da verilmezse guvenli varsayilan false'tur.
# Acikken tum uc, DTO semasi ve zorunlu alanlar herkese gorunur.
SPRINGDOC_ENABLED=true

# ---- logging ----
APP_LOG_LEVEL=INFO
ACCESS_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO

# Asgari istemci surumu kapisi. Bos birakilirsa kimse engellenmez.
# Canlida degistirmek icin PUT /admin/settings/app.minimum-version kullanilir (deploy gerekmez).
APP_MINIMUM_VERSION=

# Pasif kimlik dogrulama (ICAO 9303). Kapaliyken sunucu cipten gelen kaniti aramaz.
# Acmadan once IDENTITY_CSCA_DIRECTORY dolu olmali, aksi halde her dogrulama reddedilir.
IDENTITY_PASSIVE_AUTH_ENABLED=false
IDENTITY_CSCA_DIRECTORY=
IDENTITY_ACTIVE_AUTH_REQUIRED=false
IDENTITY_CHALLENGE_VALIDITY_MINUTES=10
